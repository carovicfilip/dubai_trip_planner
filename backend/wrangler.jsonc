// Cloudflare Worker that holds the OpenAI and OpenWeather keys for the app.
// The keys are Worker secrets (`npx wrangler secret put ...`), never in this
// file or in git. See README.md in this folder.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dubai-trip-planner-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "vars": {
    // Firebase project dubaitripplanner-ae015. App Check tokens are issued for
    // this project number and name the app in their subject. Neither is secret.
    "FIREBASE_PROJECT_NUMBER": "1085118524930",
    "ALLOWED_APP_IDS": "1:1085118524930:android:03876253e309dc1daf011b,1:1085118524930:ios:a8022d8e2cb93f65af011b"
  },
  // At most 5 trip plans a minute from one IP address, counted per Cloudflare
  // location. Normal use is one plan every few minutes.
  "ratelimits": [
    {
      "name": "PLAN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
